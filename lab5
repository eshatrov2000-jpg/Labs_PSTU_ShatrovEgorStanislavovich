#include <iostream>
#include <cstdlib>
#include <ctime>
#include <iomanip>

using namespace std;

int getMaxOnMainDiagonal(int matrix[100][100], int n) {
    int maxVal = matrix[0][0];
    for (int i = 1; i < n; i++) {
        if (matrix[i][i] > maxVal) {
            maxVal = matrix[i][i];
        }
    }
    return maxVal;
}

int countElementsGreaterThan(int matrix[100][100], int n, int threshold) {
    int count = 0;
    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            if (matrix[i][j] > threshold) {
                count++;
            }
        }
    }
    return count;
}

int main() {
    setlocale(LC_ALL, "Russian");
    srand(time(0));

    int n;
    cout << "Введите размерность квадратной матрицы (n): ";
    cin >> n;

    int A[100][100];

    cout << "\nСгенерированный массив:" << endl;
    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            A[i][j] = rand() % 100; 
            cout << setw(4) << A[i][j] << " ";
        }
        cout << endl;
    }

    int maxDiagElement = getMaxOnMainDiagonal(A, n);
    cout << "\nМаксимальный элемент на главной диагонали: " << maxDiagElement << endl;

    int resultCount = countElementsGreaterThan(A, n, maxDiagElement);

    cout << "Количество элементов, превышающих это значение: " << resultCount << endl;

    return 0;
}
