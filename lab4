#include <iostream>
#include <algorithm>

using namespace std;

void printCircular(int a[], int n, int k) {
    if (n <= 0) {
        cout << "Массив пуст." << endl;
        return;
    }

    int start = k % n; 

    for (int i = 0; i < n; i++) {
        cout << a[(start + i) % n] << " ";
    }
    cout << endl;
}

int main() { длины
    const int N = 100;
    int a[N];
    int n, k;

    cout << "Введите реальную длину массива (не более 100): ";
    if (!(cin >> n) || n > N || n <= 0) {
        cout << "Ошибка: некорректная длина массива." << endl;
        return 1;
    }
    cout << "Введите " << n << " элементов массива:" << endl;
    for (int i = 0; i < n; i++) {
        cin >> a[i];
    }

    cout << "Введите индекс K для циклической печати: ";
    cin >> k;

    cout << "\n--- Результат пункта 2 (Печать с K-го) ---" << endl;
    printCircular(a, n, k);

    cout << "\n--- Результат пункта 3 (Сортировка) ---" << endl;
    sort(a, a + n);
    for (int i = 0; i < n; i++) {
        cout << a[i] << " ";
    }
    cout << endl;

    cout << "\n--- Результат пункта 4 (Удаление четных) ---" << endl;
    int new_n = 0;
    for (int i = 0; i < n; i++) {
        if (a[i] % 2 != 0) { 
            a[new_n] = a[i];
            new_n++;
        }
    }
    n = new_n; // Изменяем реальную длину массива
    cout << "\n--- Результат пункта 5 (Печать после удаления) ---" << endl;
    printCircular(a, n, k);
    return 0;
}
