/*
Если считать алгебраически точно через формулу, то:
3. Почему результаты float и double могут отличаться
Математически ответ равен 1, но в программе:
float хранит меньше знаков после запятой
double хранит больше знаков и даёт более точный результат
Из-за этого:
при float может получиться примерно 1 или 0.999999... / 1.000000...
при double результат будет ближе к 1
Это связано с погрешностью представления вещественных чисел.
4. Решение 1 — для типа float
Программа на C++
*/
#include <iostream>
#include <cmath>
using namespace std;

int main() {
    float a = 1000.0f;
    float b = 0.0001f;

    float c = pow(a + b, 3);
    float d = pow(a, 3);
    float numerator = c - d;

    float e = 3 * a * b * b;
    float f = pow(b, 3);
    float g = 3 * a * a * b;
    float denominator = e + f + g;

    float result = numerator / denominator;

    cout << "Тип float:" << endl;
    cout << "a = " << a << endl;
    cout << "b = " << b << endl;
    cout << "(a+b)^3 = " << c << endl;
    cout << "a^3 = " << d << endl;
    cout << "Числитель = " << numerator << endl;
    cout << "3ab^2 = " << e << endl;
    cout << "b^3 = " << f << endl;
    cout << "3a^2b = " << g << endl;
    cout << "Знаменатель = " << denominator << endl;
    cout << "Результат = " << result << endl;

    return 0;
}
