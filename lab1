#include <iostream>
#include <cmath> // для pow
#include <iomanip> // для настройки вывода точности

using namespace std;

int main() {
    double a = 1000.0;
    double b = 0.0001;

    // --- РАБОТА С ТИПОМ FLOAT ---
    float af = (float)a;
    float bf = (float)b;

    // Промежуточные переменные согласно заданию
    float term1_f = pow(af + bf, 3);
    float term2_f = pow(af, 3);
    float numerator_f = term1_f - term2_f;

    float den1_f = 3 * af * bf * bf;
    float den2_f = pow(bf, 3);
    float den3_f = 3 * af * af * bf;
    float denominator_f = den1_f + den2_f + den3_f;

    float result_f = numerator_f / denominator_f;

    // --- РАБОТА С ТИПОМ DOUBLE ---
    double ad = a;
    double bd = b;

    double term1_d = pow(ad + bd, 3);
    double term2_d = pow(ad, 3);
    double numerator_d = term1_d - term2_d;

    double den1_d = 3 * ad * bd * bd;
    double den2_d = pow(bd, 3);
    double den3_d = 3 * ad * ad * bd;
    double denominator_d = den1_d + den2_d + den3_d;

    double result_d = numerator_d / denominator_d;

    // Вывод результатов с высокой точностью
    cout << fixed << setprecision(10); 
    cout << "Result float:  " << result_f << endl;
    cout << "Result double: " << result_d << endl;

    return 0;
}
